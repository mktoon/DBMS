# Choose three different local passwords. Keep .env out of Git.
# Single-quote values containing $ so Docker Compose treats them literally.
MYSQL_ROOT_PASSWORD=replace_with_a_local_database_password
MYSQL_APP_PASSWORD=replace_with_a_different_app_database_password
# Staff login password: at least 12 characters, at most 72 UTF-8 bytes.
HOSPITAL_USERNAME=staff
HOSPITAL_PASSWORD=replace_with_a_staff_login_password
HOSPITAL_TIME_ZONE=America/Los_Angeles
